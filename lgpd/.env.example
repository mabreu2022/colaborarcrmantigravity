# =============================================================================
# DPO Agentic — Template de Variáveis de Ambiente
# Arquivo  : lgpd/.env
# ATENÇÃO  : Renomeie para .env e preencha com os valores reais.
#            NUNCA comite o .env no Git.
# =============================================================================

# --- Firebird 5.0 ---
DB_HOST=127.0.0.1
DB_PORT=3050
# Caminho FÍSICO do .fdb na VPS (barras invertidas duplas no Windows)
DB_DATABASE=C:\\ColaborarCRM\\banco\\colaborarcrm.fdb
DB_USER=SYSDBA
DB_PASSWORD=TROQUE_PARA_SUA_SENHA_REAL

# --- QAP Messenger ---
# URL base do servidor QAP (sem barra no final)
QAP_BASE_URL=https://conectsolutionsti.dev.br/Messenger

# Login e senha da conta robô que enviará as mensagens
# (mesmas credenciais usadas no Conect Trelo — qapService.js)
QAP_USERNAME=ConnectTaskBot
QAP_PASSWORD=ConnectTaskPassword123!

# Telefones dos administradores que receberão o alerta (separados por vírgula)
# Formato: DDI + DDD + número, sem espaços ou sinais
# Ex: 5511945457934,5511945457973
QAP_ADMIN_PHONES=5511945457934,5511945457973

# --- VibeFlow (opcional) ---
# Se não preenchido, o step é pulado sem gerar erro
VIBEFLOW_WEBHOOK_URL=

# --- Parâmetros de negócio ---
LGPD_ANOS_INATIVIDADE=5

# --- HTTP ---
HTTP_TIMEOUT_S=15
